# Configuração do backend — copie para .env e ajuste. NUNCA commite o .env real.

# URL de conexão PostgreSQL (driver psycopg3). Desenvolvimento local via docker-compose:
DATABASE_URL=postgresql+psycopg://reiki:reiki_dev_pass@localhost:5432/reiki

# Ambientes: local (padrão), development, production
ENVIRONMENT=local

# Origens CORS permitidas (separadas por vírgula). Origem do frontend Next.js:
CORS_ORIGINS=http://localhost:3000

# Cookie de sessão
SESSION_COOKIE_NAME=reiki_session
SESSION_TTL_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
