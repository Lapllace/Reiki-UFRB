# URL base da API FastAPI (sem barra final). Obrigatória fora do modo de demonstração.
# Exemplo local: http://localhost:8000
NEXT_PUBLIC_API_URL=

# Modo de demonstração: usa dados FICTÍCIOS em memória, sem backend.
# Só tem efeito com `npm run dev`. É ignorado (desligado) em `next build`/`next start`.
NEXT_PUBLIC_DEMO_MODE=false
